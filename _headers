# ═══════════════════════════════════════════════════════════════════
#  Radio Dilson 101.9 FM — cabeceras HTTP
#
#  Este archivo tiene prioridad sobre netlify.toml. Todas las cabeceras
#  de seguridad y de caché están AQUÍ y solo aquí.
# ═══════════════════════════════════════════════════════════════════

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.gstatic.com https://www.gstatic.com https://apis.google.com https://fonts.googleapis.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://dilson101fm-default-rtdb.firebaseio.com wss://dilson101fm-default-rtdb.firebaseio.com https://*.firebaseio.com wss://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://apis.google.com https://www.gstatic.com https://api.open-meteo.com https://ws.audioscrobbler.com https://musicbrainz.org https://coverartarchive.org https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org https://tile.openstreetmap.org; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(*), notifications=(*), storage-access=(*), camera=(), microphone=(), payment=(), usb=()

# ── El panel de administración nunca debe indexarse ni cachearse ───
/admin-comunicados.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: public, max-age=0, must-revalidate

# ── El HTML siempre se revalida: aquí se publican los comunicados ──
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ── El service worker JAMÁS se cachea, o no llegan las versiones ───
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# ── El manifiesto se revalida a diario ────────────────────────────
/manifest.json
  Cache-Control: no-cache

# ── Código y estilos: se revalidan siempre (hay service worker) ────
/*.js
  Cache-Control: no-cache, must-revalidate

/*.css
  Cache-Control: no-cache, must-revalidate

# ── Imágenes: una semana, con revalidación en segundo plano ────────
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# ── El stream de audio nunca se cachea ────────────────────────────
/radio-stream
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
